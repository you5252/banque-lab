// =====================================================================
//  PIPELINE CD (Déploiement Continu)
//  Rôle : déployer une version (tag d'image) déjà construite par la CI sur Kubernetes (GKE).
//  dev → automatique après chaque merge sur main
//  recette → manuel ("Build with Parameters")
//  prod → manuel + validation humaine
//  En cas d'échec (pods qui ne démarrent pas, smoke test KO) → retour automatique à la version précédente.
//
//  Pré-configuré par infra/jenkins/casc.yaml : job "banque-lab-cd" et ses paramètres,
//  variables GCP_PROJECT, GKE_CLUSTER, GKE_ZONE, REGISTRY.
//  Pas de kubeconfig à stocker : la VM Jenkins se connecte au cluster avec son compte de service Google.
// =====================================================================
pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Tag de l\'image à déployer (sha git court)')
        choice(name: 'TARGET_ENV', choices: ['dev', 'recette', 'prod'], description: 'Environnement cible')
    }

    environment {
        NAMESPACE  = "banque-${params.TARGET_ENV}"
        TARGET_ENV = "${params.TARGET_ENV}"
        IMAGE_TAG  = "${params.IMAGE_TAG}"
        KUBECONFIG = "${WORKSPACE}/.kube/config"   // fichier de connexion au cluster, propre à ce job
    }

    options {
        timestamps()
        disableConcurrentBuilds()   // jamais deux déploiements en même temps
    }

    stages {
        stage('Vérifications') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error 'IMAGE_TAG est obligatoire'
                    }
                }
                // L'image existe-t-elle vraiment ? (évite de déployer un tag mal recopié)
                sh 'gcloud artifacts docker images describe "$REGISTRY/account-service:$IMAGE_TAG" --format="value(image_summary.digest)"'
                echo "Déploiement de ${params.IMAGE_TAG} sur ${NAMESPACE}"
            }
        }

        stage('Validation PROD') {
            when { expression { params.TARGET_ENV == 'prod' } }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Déployer ${params.IMAGE_TAG} en PRODUCTION ?", ok: 'Oui, déployer'
                }
            }
        }

        stage('Connexion au cluster') {
            steps {
                sh 'gcloud container clusters get-credentials "$GKE_CLUSTER" --zone "$GKE_ZONE" --project "$GCP_PROJECT"'
                sh 'kubectl get nodes'
            }
        }

        stage('Déploiement Kubernetes') {
            steps {
                sh '''
                    # Kafka est partagé par tous les environnements (namespace banque-kafka)
                    kubectl apply -f k8s/platform/

                    kubectl create namespace "$NAMESPACE" --dry-run=client -o yaml | kubectl apply -f -

                    # Kustomize : on part de l'overlay de l'environnement et on fixe la version de l'image
                    mkdir -p .deploy
                    cat > .deploy/kustomization.yaml <<EOF
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - ../k8s/overlays/${TARGET_ENV}
images:
  - name: account-service
    newName: ${REGISTRY}/account-service
    newTag: "${IMAGE_TAG}"
EOF
                    kubectl apply -k .deploy
                    kubectl -n "$NAMESPACE" rollout status deployment/account-service --timeout=300s
                '''
            }
        }

        stage('Smoke test') {
            steps {
                sh '''
                    kubectl -n "$NAMESPACE" run "smoke-$BUILD_NUMBER" --rm -i --restart=Never \
                        --image=curlimages/curl -- \
                        curl -fsS http://account-service:8081/actuator/health/readiness
                '''
            }
        }
    }

    post {
        failure {
            echo '❌ Échec : retour à la version précédente'
            sh 'kubectl -n "$NAMESPACE" rollout undo deployment/account-service || true'
        }
        success {
            echo "✅ ${params.IMAGE_TAG} déployé sur ${NAMESPACE}"
            sh 'kubectl -n "$NAMESPACE" get pods -o wide'
        }
    }
}
