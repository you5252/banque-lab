// =====================================================================
//  PIPELINE CI (Intégration Continue)
//  Rôle : à chaque push sur n'importe quelle branche → compiler, tester.
//  Sur la branche main uniquement : construire les images Docker, les pousser
//  dans Artifact Registry (Google Cloud) et déclencher la CD vers l'environnement dev.
//
//  Tout est pré-configuré par infra/jenkins/casc.yaml :
//   - outils JDK "jdk21" et Maven "maven3"
//   - variable REGISTRY (adresse du dépôt d'images Artifact Registry)
//   - job multibranch "banque-lab-ci" qui lit ce fichier
//  Pas de mot de passe Docker : la VM Jenkins s'authentifie avec son compte de service Google.
// =====================================================================
pipeline {
    agent any

    tools {
        jdk 'jdk21'
        maven 'maven3'
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Préparation') {
            steps {
                script {
                    env.IMAGE_TAG = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                }
                echo "Version construite : ${env.IMAGE_TAG}"
            }
        }

        stage('Build & tests') {
            parallel {
                stage('account-service') {
                    steps {
                        dir('services/account-service') {
                            sh 'mvn -B clean verify'
                        }
                    }
                    post {
                        always {
                            junit 'services/account-service/target/surefire-reports/*.xml'
                            archiveArtifacts artifacts: 'services/account-service/target/cucumber-report.html',
                                             allowEmptyArchive: true
                        }
                    }
                }
                stage('batch-service') {
                    steps {
                        dir('services/batch-service') {
                            sh 'mvn -B clean verify'
                        }
                    }
                    post {
                        always {
                            junit 'services/batch-service/target/surefire-reports/*.xml'
                        }
                    }
                }
            }
        }

        // Tâche S7-5 : ajouter ici un stage SonarQube + "Quality Gate"
        // Tâche S7-3 (testeuse) : ajouter ici un stage "Tests Playwright"

        stage('Images Docker') {
            when { branch 'main' }
            steps {
                sh 'docker build -t "$REGISTRY/account-service:$IMAGE_TAG" services/account-service'
                sh 'docker build -t "$REGISTRY/batch-service:$IMAGE_TAG" services/batch-service'
            }
        }

        stage('Push des images') {
            when { branch 'main' }
            steps {
                // Configure Docker pour utiliser les identifiants Google de la VM (aucun secret stocké dans Jenkins)
                sh 'gcloud auth configure-docker "${REGISTRY%%/*}" --quiet'
                sh 'docker push "$REGISTRY/account-service:$IMAGE_TAG"'
                sh 'docker push "$REGISTRY/batch-service:$IMAGE_TAG"'
            }
            post {
                always {
                    // Les images sont dans Artifact Registry : inutile de les garder sur le disque de la VM
                    sh 'docker rmi "$REGISTRY/account-service:$IMAGE_TAG" "$REGISTRY/batch-service:$IMAGE_TAG" || true'
                }
            }
        }

        stage('Déclencher la CD (dev)') {
            when { branch 'main' }
            steps {
                build job: 'banque-lab-cd', wait: false, parameters: [
                    string(name: 'IMAGE_TAG', value: env.IMAGE_TAG),
                    string(name: 'TARGET_ENV', value: 'dev')
                ]
            }
        }
    }

    post {
        failure { echo '❌ La CI a échoué : regarde le premier stage en rouge.' }
        success { echo "✅ CI verte. Image ${env.IMAGE_TAG} prête à être déployée." }
    }
}
